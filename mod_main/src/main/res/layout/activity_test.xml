<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="测试页面"
                android:textColor="#333333"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPermission"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="权限测试"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnWebView"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="跳转WebView页面"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnEdit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="跳转编辑页面"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnMain"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="跳转到主页(我的Tab)"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnExternalUrl"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="测试外部URL跳转"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnTestAll"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="测试所有路由"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnFlowTest"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="Flow状态测试"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnRxjavaFlowTest"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="RxJava转Flow测试"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnAudio"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="录音测试"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnDialog"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="弹窗测试"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnNetWork"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="网络请求测试"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnNetWork2"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="网络请求测试2"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnKmp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="KMP共享模块测试"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/tvKmpResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#F5F5F5"
                android:minHeight="80dp"
                android:padding="12dp"
                android:text="点击上方按钮查看 KMP shared 模块调用结果"
                android:textColor="#333333"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnKmpNetwork"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="KMP Ktor网络请求"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/tvKmpNetworkResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#FFF8E1"
                android:minHeight="80dp"
                android:padding="12dp"
                android:text="点击上方按钮通过 Ktor 发起跨平台网络请求"
                android:textColor="#333333"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnKmpLogin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="KMP业务逻辑示例(登录)"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/tvKmpLoginResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#E8F5E9"
                android:minHeight="80dp"
                android:padding="12dp"
                android:text="点击上方按钮演示 KMP 业务逻辑（Repository + UseCase）"
                android:textColor="#333333"
                android:textSize="13sp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </ScrollView>
</layout>